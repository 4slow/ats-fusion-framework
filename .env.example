# Copy to .env and fill values for LIVE mode
IBKR_HOST=127.0.0.1
IBKR_PORT=7497   # 7497 paper TWS, 7496 live TWS (default)
IBKR_CLIENT_ID=12

# Trading settings (LIVE)
LIVE_SYMBOL=SPY
LIVE_EXCHANGE=SMART
LIVE_CURRENCY=USD
LIVE_SEC_TYPE=STK

# Bar settings
LIVE_BAR_SIZE=5 mins
LIVE_LOOKBACK_DAYS=30

# Safety gates
LIVE_MAX_NEW_TRADES=1
LIVE_MAX_OPEN_POSITIONS=2
